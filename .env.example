# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Required (unless DEVIN_SIMULATE=true) ---
# Devin service user key (starts with cog_) and organization id (starts with org-)
DEVIN_API_KEY=cog_replace_me
DEVIN_ORG_ID=org-replace_me
# GitHub token with read/write access to Issues on the target repository
GITHUB_TOKEN=replace_me
# The secret entered in the GitHub webhook settings
GITHUB_WEBHOOK_SECRET=replace_me
# The fork Devin works on, as owner/name
TARGET_REPO=your-user/superset

# --- Optional (defaults shown) ---
TRIGGER_LABEL=tech-debt
POLL_INTERVAL_SECONDS=30
RUN_TIMEOUT_MINUTES=60
DEVIN_MAX_ACU_LIMIT=10
DATABASE_PATH=data/runs.db
# Sweep for labeled issues that no webhook reported: at startup, and at most this many per sweep
SYNC_ON_STARTUP=true
SYNC_MAX_RUNS=5
# Simulation mode: fake Devin, GitHub and Slack. The required values above are then optional.
DEVIN_SIMULATE=false
DEVIN_SIMULATE_POLLS=2
# Slack incoming webhook; leave empty to disable notifications
SLACK_WEBHOOK_URL=
